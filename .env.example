# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5-20251101
# MAX_TOKENS=4096
# MAX_AGENT_ITERATIONS=15

# ── SAP S/4HANA connection ─────────────────────────────────────────────────
SAP_BASE_URL=https://my-s4hana.example.com
SAP_USER=PROC_API_USER
SAP_PASSWORD=secret
SAP_CLIENT=100
# SAP_CERT_PATH=/path/to/cert.pem   # leave empty to use system CA bundle

# ── Business defaults ──────────────────────────────────────────────────────
DEFAULT_PURCHASING_ORG=1010

# ── Scoring weights (must sum to 1.0) ─────────────────────────────────────
WEIGHT_PRICE=0.35
WEIGHT_DELIVERY=0.30
WEIGHT_EVALUATION=0.35

# ── Development mode ───────────────────────────────────────────────────────
# Set to true to use mock data instead of live SAP APIs
USE_MOCK_DATA=false
